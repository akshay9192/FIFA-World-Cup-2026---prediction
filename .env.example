# Optional locally; omit it to use sqlite:///./fifa_predictor.db.
# Production example: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=sqlite:///./fifa_predictor.db

# Comma-separated frontend origins. Do not add a trailing slash.
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Optional. The verified offline replay works without an external API key.
FOOTBALL_DATA_API_KEY=

# Frontend-only and public. Configure this in frontend/.env.local or Netlify.
REACT_APP_API_BASE=http://localhost:8000
